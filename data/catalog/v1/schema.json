{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://phonology024.github.io/make-localllm-easier/catalog/v1/schema.json",
 "title": "make-localllm-easier measured model catalog, v1",
 "description": "Local LLM files measured end to end: accuracy per language and suite, memory parts and decode speed on named hardware. v1 only gains optional fields; anything breaking goes to v2.",
 "type": "object",
 "required": ["catalog_version", "catalog_rev", "license", "source", "hardware", "models"],
 "properties": {
  "$schema": {"type": "string"},
  "catalog_version": {"const": 1},
  "catalog_rev": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "Changes whenever any model entry changes."},
  "license": {"const": "MIT", "description": "License of this data file."},
  "source": {"type": "string", "format": "uri"},
  "scores_are": {"type": "string"},
  "hardware": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "gpu", "vram_gb", "os", "runtime", "backend"],
    "properties": {
     "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
     "gpu": {"type": "string"},
     "vram_gb": {"type": "number", "exclusiveMinimum": 0, "description": "As the OS reports it, same as data/leaderboard.json."},
     "ram_gb": {"type": "number", "exclusiveMinimum": 0},
     "os": {"type": "string"},
     "runtime": {"type": "string"},
     "backend": {"type": "string", "description": "e.g. vulkan, cuda, rocm, metal, cpu"}
    }
   }
  },
  "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}}
 },
 "$defs": {
  "gib": {"type": "number", "minimum": 0},
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "model": {
   "type": "object",
   "required": ["id", "format", "hf_repo", "file", "rev", "sha256", "bits_per_weight", "qat", "max_ctx", "moe",
                "memory", "vision", "speed", "scores"],
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "format": {"enum": ["gguf"], "description": "Later formats (e.g. mlx, safetensors) will be added to this list."},
    "hf_repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "file": {"type": "string"},
    "rev": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "Hugging Face commit the file is pinned to."},
    "sha256": {"$ref": "#/$defs/sha256"},
    "bits_per_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 32},
    "qat": {"type": "boolean", "description": "Quantization-aware trained weights."},
    "max_ctx": {"type": "integer", "minimum": 1},
    "moe": {
     "oneOf": [
      {"type": "null"},
      {"type": "object", "required": ["layers", "expert_gib_per_layer"],
       "properties": {"layers": {"type": "integer", "minimum": 1}, "expert_gib_per_layer": {"$ref": "#/$defs/gib"}}}
     ]
    },
    "memory": {
     "type": "object",
     "required": ["weights_gib", "kv_kib_per_token_q8", "fixed_cache_gib", "checkpoint_gib", "cpu_mapped_gib"],
     "properties": {
      "weights_gib": {"$ref": "#/$defs/gib"},
      "kv_kib_per_token_q8": {"type": "number", "minimum": 0, "description": "KV cache per context token with q8_0 K and V."},
      "fixed_cache_gib": {"$ref": "#/$defs/gib"},
      "checkpoint_gib": {"$ref": "#/$defs/gib"},
      "cpu_mapped_gib": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/gib"}],
                         "description": "Part of the weights that stays in system RAM even with every layer on the GPU; null when not measured."}
     }
    },
    "vision": {
     "oneOf": [
      {"type": "null"},
      {"type": "object", "required": ["mmproj_file", "mmproj_gib", "mmproj_sha256"],
       "properties": {"mmproj_file": {"type": "string"}, "mmproj_gib": {"$ref": "#/$defs/gib"},
                      "mmproj_sha256": {"$ref": "#/$defs/sha256"}}}
     ]
    },
    "speed": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["hardware", "decode_tok_s", "confidence"],
      "properties": {
       "hardware": {"type": "string", "description": "An id from the top-level hardware list."},
       "llama_cpp": {"type": "string"},
       "decode_tok_s": {"type": "number", "exclusiveMinimum": 0},
       "confidence": {"enum": ["measured", "estimated"]},
       "mtp_draft_tokens": {"type": "integer", "minimum": 0, "description": "Multi-token-prediction draft length used; 0 = off."},
       "moe_offload": {
        "type": "array",
        "items": {"type": "object", "required": ["layers_in_ram", "decode_tok_s"],
                  "properties": {"layers_in_ram": {"type": "integer", "minimum": 1},
                                 "decode_tok_s": {"type": "number", "exclusiveMinimum": 0}}}
       }
      }
     }
    },
    "scores": {
     "type": "object",
     "propertyNames": {"pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})?/[a-z0-9_-]{1,32}$"},
     "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}
    },
    "note": {"type": "string"}
   }
  }
 }
}
